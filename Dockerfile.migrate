# syntax=docker/dockerfile:1.7
FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
RUN --mount=type=cache,id=ehf-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store \
    && pnpm --filter @ehf/persistence... --filter @ehf/case-store... install --prod --prefer-offline --frozen-lockfile --config.minimum-release-age=0 --network-concurrency=4 --fetch-retries=5 --fetch-timeout=120000
RUN groupadd --system --gid 1001 ehf && useradd --system --uid 1001 --gid ehf --home-dir /nonexistent ehf
USER 1001:1001
CMD ["sh", "-c", "./packages/persistence/node_modules/.bin/tsx packages/persistence/src/migrate.ts && ./packages/case-store/node_modules/.bin/tsx packages/case-store/src/migrate.ts"]
