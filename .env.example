DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/ehf
CONTROL_API_PORT=4100
CASE_API_PORT=4102
GATEWAY_PORT=4101
CAPABILITY_GATEWAY_URL=http://127.0.0.1:4101
EXECUTION_ENVELOPE_SECRET=local-development-secret-change-me
# Platform mode selects the identity, database and signing adapters. Azure mode refuses
# to start when a local-mode credential or a password-bearing database URL is present.
PLATFORM_MODE=local
IDENTITY_PROVIDER=local_headers
LOCAL_DEFAULT_TENANT_ID=tenant_demo
# Workload credentials between services. Replaced by managed identity in Azure mode.
EDGE_SERVICE_TOKEN=local-edge-service-token-change-me-now
RUNTIME_SERVICE_TOKEN=local-runtime-service-token-change-me
# Signs the per-invocation runtime grant. Held by the dispatcher and the control-plane
# broker only; the runtime holds neither this nor the envelope secret.
RUNTIME_GRANT_SECRET=local-runtime-grant-secret-change-me
ENVELOPE_BROKER_URL=http://127.0.0.1:4100
# Demo personas the control surface acts as. Authoring and approval are separate
# identities so the local stack exercises separation of duties.
CONTROL_UI_ACTOR_ID=local-author
CONTROL_UI_ACTOR_ROLES=Harness.Reader,Harness.Author,Harness.Operator,Case.Analyst,Case.Reviewer
CONTROL_UI_APPROVER_ID=local-approver
CONTROL_UI_APPROVER_ROLES=Harness.Reader,Harness.Approver
RUNTIME_PROVIDER=local_http
RUNTIME_LOCAL_ENDPOINT=http://127.0.0.1:8088/invocations
RUNTIME_HOST_PORT=8088
RUNTIME_HOST_AUTH_TOKEN=local-runtime-host-token-change-me
# postgres keeps runs resumable; memory removes the runtime's last database credential
# at the cost of resumability.
RUNTIME_CHECKPOINT_BACKEND=postgres
RUNTIME_CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/ehf
# Required only when RUNTIME_PROVIDER=azure_foundry.
FOUNDRY_AGENT_INVOCATION_ENDPOINT=
FOUNDRY_AGENT_NAME=
FOUNDRY_AGENT_VERSION=
FOUNDRY_TOKEN_SCOPE=https://ai.azure.com/.default
AZURE_CLIENT_ID=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:4100
OPENROUTER_APP_NAME=EHF Local POC
MODEL_PROFILES_PATH=config/model-profiles.json
WORKER_POLL_MS=1000
WORKER_LEASE_SECONDS=30
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_TRACES_SAMPLER_ARG=1
DEPLOYMENT_ENVIRONMENT=local
CLOUD_REGION=local
TRACE_VIEWER_BASE_URL=http://localhost:16686
CONTROL_API_INTERNAL_URL=http://127.0.0.1:4100
CAPABILITY_GATEWAY_INTERNAL_URL=http://127.0.0.1:4101
CASE_API_INTERNAL_URL=http://127.0.0.1:4102
CASE_UI_TENANT_ID=tenant_demo
JAEGER_API_INTERNAL_URL=http://127.0.0.1:16686
TRACE_VIEWER_PUBLIC_URL=http://localhost:16686
CASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/ehf
CASE_CORE_SCHEMA=case_core
CASE_LEDGER_SCHEMA=case_ledger
EVIDENCE_SCHEMA=evidence
CASE_ARTIFACT_BACKEND=postgres
CASE_EVIDENCE_REQUIRE_SCAN=false
CASE_EVIDENCE_MAX_BYTES=1048576
