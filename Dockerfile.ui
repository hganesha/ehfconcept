FROM node:24-bookworm-slim AS builder
WORKDIR /app
RUN npm install --global pnpm@11.9.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY config ./config
RUN --mount=type=cache,id=ehf-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile --config.minimum-release-age=0 --network-concurrency=4 --fetch-retries=5 --fetch-timeout=120000
RUN pnpm --filter @ehf/control-ui build

FROM node:24-bookworm-slim AS runner
WORKDIR /app/apps/control-ui
ENV NODE_ENV=production
ENV PORT=4200
ENV HOSTNAME=0.0.0.0
COPY --from=builder /app/apps/control-ui/.next/standalone /app/
COPY --from=builder /app/apps/control-ui/.next/static ./.next/static
EXPOSE 4200
CMD ["node", "server.js"]
